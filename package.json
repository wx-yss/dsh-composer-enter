{
  "name": "dsh-composer-enter",
  "version": "0.1.0",
  "description": "让 DSH 0.1.5 使用 Enter 换行、Cmd/Ctrl+Enter 提交。",
  "type": "module",
  "main": "lib/index.js",
  "exports": { ".": "./lib/index.js", "./client": "./lib/client.js", "./package.json": "./package.json" },
  "files": ["lib", "cordis.bundle.yml", "README.md", "LICENSE"],
  "scripts": { "test": "node test/run.mjs", "check": "node --check lib/index.js && node --check lib/client.js && npm test" },
  "dsh": {
    "bundle": { "patch": "./cordis.bundle.yml" },
    "client": { "platform": "web", "inject": [] }
  },
  "repository": { "type": "git", "url": "git+https://github.com/wx-yss/dsh-composer-enter.git" },
  "bugs": { "url": "https://github.com/wx-yss/dsh-composer-enter/issues" },
  "homepage": "https://github.com/wx-yss/dsh-composer-enter#readme",
  "keywords": ["dsh", "composer", "keyboard"],
  "license": "MIT"
}
